      "dashboardIdentifier": null,
      "property": "text.widget",
      "value": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"dark light\">\n<title>Product analytics</title>\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/3.2.0/tabler-icons.min.css\">\n<style>\n:root{\n  --surface-0:#141413; --surface-1:#1f1f1e; --surface-2:#262624;\n  --text-primary:#ffffff; --text-secondary:#c3c2b7; --text-muted:#898781;\n  --border:rgba(255,255,255,.10); --border-strong:rgba(255,255,255,.18); --border-stronger:rgba(255,255,255,.30);\n  --grid:#2c2c2a; --axis:#383835; --track:#2c2c2a;\n  --s1:#3987e5; --s2:#d95926; --s3:#199e70; --s4:#c98500;\n  --pos:#0ca30c; --neg:#e66767;\n  --heat-1:#0c447c; --heat-2:#185fa5; --heat-3:#378add; --heat-4:#85b7eb; --heat-5:#b5d4f4;\n  --heat-ink-lo:#b5d4f4; --heat-ink-hi:#042c53;\n  --radius:8px;\n  --font-sans:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Inter,Helvetica,Arial,sans-serif;\n}\n[data-mode=\"light\"]{\n  --surface-0:#f7f6f3; --surface-1:#f1efe8; --surface-2:#ffffff;\n  --text-primary:#0b0b0b; --text-secondary:#52514e; --text-muted:#898781;\n  --border:rgba(11,11,11,.10); --border-strong:rgba(11,11,11,.18); --border-stronger:rgba(11,11,11,.30);\n  --grid:#e1e0d9; --axis:#c3c2b7; --track:#e1e0d9;\n  --s1:#2a78d6; --s2:#eb6834; --s3:#1baf7a; --s4:#eda100;\n  --pos:#0ca30c; --neg:#d03b3b;\n  --heat-1:#e6f1fb; --heat-2:#b5d4f4; --heat-3:#85b7eb; --heat-4:#378add; --heat-5:#185fa5;\n  --heat-ink-lo:#0c447c; --heat-ink-hi:#042c53;\n}\n*{box-sizing:border-box}\nbody{margin:0;padding:2.5rem 1.25rem;background:var(--surface-0);color:var(--text-primary);\n  font-family:var(--font-sans);font-size:16px;line-height:1.7;-webkit-font-smoothing:antialiased}\n.wrap{max-width:760px;margin:0 auto}\n.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\n.kpi{background:var(--surface-1);border-radius:var(--radius);padding:14px 16px}\n.kpi-l{font-size:13px;color:var(--text-secondary);margin:0 0 6px}\n.kpi-v{font-size:24px;font-weight:500;line-height:1.1;font-variant-numeric:tabular-nums}\n.dl{font-size:12px;font-variant-numeric:tabular-nums;margin-top:4px}\n.seg{font-family:inherit;font-size:12px;padding:5px 11px;border-radius:var(--radius);\n  border:.5px solid var(--border-strong);background:transparent;color:var(--text-secondary);cursor:pointer;\n  transition:background .12s ease,color .12s ease}\n.seg:hover{background:var(--surface-1)}\n.seg:active{transform:scale(.98)}\n.seg:focus-visible{outline:2px solid var(--s1);outline-offset:2px}\n.seg[aria-pressed=\"true\"]{background:var(--surface-1);color:var(--text-primary);border-color:var(--border-stronger)}\n.sec{font-size:13px;font-weight:500;margin:0 0 2px}\n.sub{font-size:12px;color:var(--text-muted);margin:0 0 12px}\n.cell{height:30px;border-radius:3px;display:flex;align-items:center;justify-content:center;\n  font-size:11px;font-variant-numeric:tabular-nums}\n.rule{border-top:.5px solid var(--border);padding-top:1.25rem}\n.grid-kpi{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-bottom:1.75rem}\n.grid-two{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:28px}\n.heat-row{display:grid;grid-template-columns:44px repeat(5,minmax(0,1fr));gap:4px;align-items:center;margin-bottom:4px}\n@media (prefers-reduced-motion: reduce){*{transition:none!important;animation:none!important}}\n\n@media print{\n  html,body{height:auto;overflow:hidden}\n  body{padding:0;background:var(--surface-0);\n    -webkit-print-color-adjust:exact;print-color-adjust:exact}\n  .wrap{max-width:none}\n  .rule,.kpi,.heat-row{break-inside:avoid}\n  .wrap>*:last-child{margin-bottom:0;padding-bottom:0}\n  #cohort>p:last-child{margin-bottom:0}\n  #chartbox{height:230px}\n}\n</style>\n<script>\n(function(){\n  var forced=new URLSearchParams(location.search).get('mode');\n  var root=document.documentElement;\n  if(forced==='light'||forced==='dark')root.dataset.mode=forced;\n  window.setMode=function(m){root.dataset.mode=m;if(window.__applyTheme)window.__applyTheme();};\n})();\n</script>\n</head>\n<body>\n<div class=\"wrap\">\n  <h1 class=\"sr-only\">Product analytics dashboard</h1>\n\n  <div style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px;flex-wrap:wrap\">\n    <div style=\"display:flex;align-items:center;gap:8px;font-size:12px;color:var(--text-muted)\">\n      <i class=\"ti ti-chart-dots\" style=\"font-size:16px\" aria-hidden=\"true\"></i>\n      <span id=\"rangeNote\">Last 30 days &middot; compared with prior period</span>\n    </div>\n    <div style=\"display:flex;gap:6px\" id=\"segs\" role=\"group\" aria-label=\"Date range\">\n      <button class=\"seg\" data-r=\"7\" aria-pressed=\"false\">7d</button>\n      <button class=\"seg\" data-r=\"30\" aria-pressed=\"true\">30d</button>\n      <button class=\"seg\" data-r=\"90\" aria-pressed=\"false\">90d</button>\n    </div>\n  </div>\n\n  <div class=\"grid-kpi\" id=\"kpis\"></div>\n\n  <div class=\"rule\" style=\"margin-bottom:1.75rem\">\n    <p class=\"sec\">Sessions by acquisition channel</p>\n    <p class=\"sub\">Daily, seven-day smoothed</p>\n    <div id=\"legend\" style=\"display:flex;flex-wrap:wrap;gap:14px;margin-bottom:10px;font-size:12px;color:var(--text-secondary)\"></div>\n    <div id=\"chartbox\" style=\"position:relative;width:100%;height:260px\">\n      <canvas id=\"ts\" role=\"img\" aria-label=\"Multi-line chart of daily sessions split across organic, paid, referral and direct channels\">Organic leads all channels, with paid second and growing.</canvas>\n    </div>\n  </div>\n\n  <div class=\"rule grid-two\">\n    <div>\n      <p class=\"sec\">Activation funnel</p>\n      <p class=\"sub\">Step-to-step conversion</p>\n      <div id=\"funnel\"></div>\n    </div>\n    <div>\n      <p class=\"sec\">Cohort retention</p>\n      <p class=\"sub\">Share of signups still active, by weeks since signup</p>\n      <div id=\"cohort\"></div>\n    </div>\n  </div>\n</div>\n\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js\"></script>\n<script>\n(function () {\n  function tok(n) {\n    return getComputedStyle(document.documentElement).getPropertyValue(n).trim();\n  }\n\n  var mut, grid, axis, C, track, heat, heatInk;\n  function readTokens() {\n    mut = tok('--text-muted'); grid = tok('--grid'); axis = tok('--axis'); track = tok('--track');\n    C = [tok('--s1'), tok('--s2'), tok('--s3'), tok('--s4')];\n    heat = [tok('--heat-1'), tok('--heat-2'), tok('--heat-3'), tok('--heat-4'), tok('--heat-5')];\n    heatInk = [tok('--heat-ink-lo'), tok('--heat-ink-hi')];\n  }\n  readTokens();\n\n  var chans = ['Organic', 'Paid', 'Referral', 'Direct'];\n  var currentRange = 30;\n\n  // Deterministic sample data. Swap this block for your own series.\n  var seed = 42;\n  function rnd() { seed = (seed * 1664525 + 1013904223) % 4294967296; return seed / 4294967296; }\n  var N = 90;\n  var series = chans.map(function (_, i) {\n    var base = [520, 300, 140, 190][i], growth = [1.004, 1.0075, 1.001, 1.0015][i], out = [];\n    for (var d = 0; d < N; d++) {\n      var weekend = (d % 7 === 5 || d % 7 === 6) ? 0.82 : 1;\n      out.push(base * Math.pow(growth, d) * weekend * (0.92 + rnd() * 0.16));\n    }\n    return out;\n  });\n\n  function total(range, offset) {\n    offset = offset || 0;\n    var t = 0;\n    for (var i = 0; i < 4; i++) for (var d = N - range - offset; d < N - offset; d++) t += series[i][d];\n    return t;\n  }\n  function fmt(n) { return Math.round(n).toLocaleString(); }\n  function money(n) { return '$' + Math.round(n).toLocaleString(); }\n\n  function spark(vals, color) {\n    var mn = Math.min.apply(null, vals), mx = Math.max.apply(null, vals), p = '';\n    vals.forEach(function (y, i) {\n      p += (i ? 'L' : 'M') + (i / (vals.length - 1) * 100).toFixed(1) + ',' +\n           (22 - ((y - mn) / ((mx - mn) || 1)) * 20).toFixed(1);\n    });\n    return '<svg viewBox=\"0 0 100 24\" preserveAspectRatio=\"none\" style=\"width:100%;height:24px;margin-top:8px\" aria-hidden=\"true\">' +\n           '<path d=\"' + p + '\" fill=\"none\" stroke=\"' + color + '\" stroke-width=\"1.6\" vector-effect=\"non-scaling-stroke\" stroke-linejoin=\"round\"/></svg>';\n  }\n\n  function renderKpis(range) {\n    var now = total(range), prev = total(range, range);\n    var lift = (now / prev - 1) * 100;\n    var defs = [\n      { label: 'Sessions',        value: fmt(now),            delta: lift,       color: C[0], flat: false },\n      { label: 'Signups',         value: fmt(now * 0.061),    delta: lift + 1.9, color: C[2], flat: false },\n      { label: 'Activation rate', value: (41.3 - (range === 7 ? 1.4 : 0)).toFixed(1) + '%', delta: -2.1, color: C[1], flat: true },\n      { label: 'Net revenue',     value: money(now * 1.94),   delta: lift + 4.3, color: C[3], flat: false }\n    ];\n    document.getElementById('kpis').innerHTML = defs.map(function (k) {\n      var vals = [];\n      for (var d = N - range; d < N; d++) {\n        var t = 0; for (var i = 0; i < 4; i++) t += series[i][d];\n        vals.push(k.flat ? (t % 17) + 38 : t);\n      }\n      var up = k.delta >= 0;\n      var col = up ? tok('--pos') : tok('--neg');\n      return '<div class=\"kpi\"><p class=\"kpi-l\">' + k.label + '</p>' +\n             '<div class=\"kpi-v\">' + k.value + '</div>' +\n             '<div class=\"dl\" style=\"color:' + col + '\"><i class=\"ti ti-' + (up ? 'arrow-up-right' : 'arrow-down-right') +\n             '\" style=\"font-size:13px;vertical-align:-1px\" aria-hidden=\"true\"></i> ' +\n             (up ? '+' : '') + k.delta.toFixed(1) + '%</div>' + spark(vals, k.color) + '</div>';\n    }).join('');\n  }\n\n  function renderLegend() {\n    document.getElementById('legend').innerHTML = chans.map(function (c, i) {\n      return '<span style=\"display:flex;align-items:center;gap:5px\">' +\n             '<span style=\"width:10px;height:10px;border-radius:2px;background:' + C[i] + '\"></span>' + c + '</span>';\n    }).join('');\n  }\n\n  var chart = new Chart(document.getElementById('ts'), {\n    type: 'line',\n    data: {\n      labels: [],\n      datasets: chans.map(function (c, i) {\n        return {\n          label: c, data: [], borderColor: C[i], backgroundColor: C[i], borderWidth: 2,\n          borderDash: [[], [5, 4], [2, 3], [8, 3, 2, 3]][i],\n          pointRadius: 0, pointHoverRadius: 4, tension: 0.35\n        };\n      })\n    },\n    options: {\n      responsive: true, maintainAspectRatio: false,\n      interaction: { mode: 'index', intersect: false },\n      plugins: {\n        legend: { display: false },\n        tooltip: { callbacks: { label: function (c) { return c.dataset.label + ': ' + Math.round(c.parsed.y).toLocaleString(); } } }\n      },\n      scales: {\n        y: {\n          beginAtZero: true, border: { display: false }, grid: { color: grid },\n          ticks: { color: mut, font: { size: 11 }, callback: function (x) { return x >= 1000 ? (x / 1000) + 'k' : x; } }\n        },\n        x: {\n          grid: { display: false }, border: { color: axis },\n          ticks: { color: mut, font: { size: 11 }, maxRotation: 0, autoSkipPadding: 24 }\n        }\n      }\n    }\n  });\n\n  function draw(range) {\n    currentRange = range;\n    var labels = [];\n    for (var d = N - range; d < N; d++) labels.push('D' + (d - (N - range) + 1));\n    chart.data.labels = labels;\n    chart.data.datasets.forEach(function (ds, i) {\n      ds.data = series[i].slice(N - range).map(function (_, j, arr) {\n        var from = Math.max(0, j - 6), slice = arr.slice(from, j + 1);\n        return slice.reduce(function (a, b) { return a + b; }, 0) / slice.length;\n      });\n    });\n    chart.update();\n    renderKpis(range);\n    document.getElementById('rangeNote').textContent = 'Last ' + range + ' days \\u00b7 compared with prior period';\n  }\n\n  var steps = [['Visited site', 100], ['Started trial', 24.6], ['Completed setup', 15.1], ['Invited a teammate', 9.2], ['Converted to paid', 5.4]];\n  function renderFunnel() {\n    document.getElementById('funnel').innerHTML = steps.map(function (st, i) {\n      var drop = i ? ((st[1] / steps[i - 1][1] - 1) * 100).toFixed(0) : null;\n      return '<div style=\"margin-bottom:10px\">' +\n        '<div style=\"display:flex;justify-content:space-between;font-size:12px;color:var(--text-secondary);margin-bottom:4px\">' +\n        '<span>' + st[0] + '</span>' +\n        '<span style=\"font-variant-numeric:tabular-nums;color:var(--text-primary)\">' + st[1].toFixed(1) + '%' +\n        (drop ? ' <span style=\"color:var(--neg)\">' + drop + '%</span>' : '') + '</span></div>' +\n        '<div style=\"height:10px;background:' + track + ';border-radius:0 4px 4px 0\">' +\n        '<div style=\"height:10px;width:' + st[1] + '%;background:' + C[0] + ';opacity:' + (1 - i * 0.13).toFixed(2) +\n        ';border-radius:0 4px 4px 0\"></div></div></div>';\n    }).join('');\n  }\n\n  var weeks = [0, 1, 2, 4, 8], cohorts = ['Mar', 'Apr', 'May', 'Jun', 'Jul'];\n  function renderCohort() {\n    var html = '<div class=\"heat-row\" style=\"font-size:11px;color:var(--text-muted)\"><span></span>' +\n      weeks.map(function (w) { return '<span style=\"text-align:center\">W' + w + '</span>'; }).join('') + '</div>';\n    cohorts.forEach(function (c, ci) {\n      html += '<div class=\"heat-row\"><span style=\"font-size:12px;color:var(--text-secondary)\">' + c + '</span>';\n      weeks.forEach(function (w) {\n        var val = 100 * Math.exp(-w * (0.20 - ci * 0.018));\n        var idx = Math.min(4, Math.floor(val / 22));\n        html += '<div class=\"cell\" style=\"background:' + heat[idx] + ';color:' + (idx >= 3 ? heatInk[1] : heatInk[0]) + '\">' +\n                Math.round(val) + '</div>';\n      });\n      html += '</div>';\n    });\n    document.getElementById('cohort').innerHTML = html +\n      '<p style=\"font-size:11px;color:var(--text-muted);margin:8px 0 0\">Values are percent retained. Later cohorts hold better past week 4.</p>';\n  }\n\n  window.__applyTheme = function () {\n    readTokens();\n    chart.data.datasets.forEach(function (ds, i) { ds.borderColor = C[i]; ds.backgroundColor = C[i]; });\n    chart.options.scales.y.grid.color = grid;\n    chart.options.scales.y.ticks.color = mut;\n    chart.options.scales.x.border.color = axis;\n    chart.options.scales.x.ticks.color = mut;\n    renderLegend(); renderFunnel(); renderCohort(); draw(currentRange);\n  };\n\n  document.querySelectorAll('#segs .seg').forEach(function (b) {\n    b.addEventListener('click', function () {\n      document.querySelectorAll('#segs .seg').forEach(function (x) { x.setAttribute('aria-pressed', 'false'); });\n      b.setAttribute('aria-pressed', 'true');\n      draw(+b.dataset.r);\n    });\n  });\n\n  renderLegend();\n  renderFunnel();\n  renderCohort();\n  draw(30);\n})();\n</script>\n</body>\n</html>"
